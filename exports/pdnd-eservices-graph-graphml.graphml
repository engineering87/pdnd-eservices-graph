<?xml version="1.0" encoding="UTF-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns
         http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <!-- PDND E-Services Graph. Fonte: https://github.com/engineering87/pdnd-eservices-graph -->
  <!-- DOI: 10.5281/zenodo.19989954. Codice AGPL-3.0, dati di origine CC0 1.0 (italia/pdnd-opendata). Snapshot: 2026-05-02 -->
  <!-- Le relazioni erogatore-fruitore non sono pubblicate come open data e sono ricostruite da documentazione pubblica: vedere il campo origine di ogni arco. I nodi marcati aggregato=true rappresentano insiemi di enti (per esempio circa 7.500 Comuni in un solo nodo): le misure di grado su questo grafo non sono confrontabili con quelle di un grafo non aggregato. -->
  <key id="n_label" for="node" attr.name="label" attr.type="string"/>
  <key id="n_categoria" for="node" attr.name="categoria" attr.type="string"/>
  <key id="n_tipo" for="node" attr.name="tipo" attr.type="string"/>
  <key id="n_aggregato" for="node" attr.name="aggregato" attr.type="boolean"/>
  <key id="n_descrizione" for="node" attr.name="descrizione" attr.type="string"/>
  <key id="e_weight" for="edge" attr.name="weight" attr.type="int"/>
  <key id="e_origine" for="edge" attr.name="origine" attr.type="string"/>
  <key id="e_servizi" for="edge" attr.name="servizi" attr.type="string"/>
  <key id="g_avvertenza" for="graph" attr.name="avvertenza" attr.type="string"/>
  <key id="g_fonte" for="graph" attr.name="fonte" attr.type="string"/>
  <key id="g_doi" for="graph" attr.name="doi" attr.type="string"/>
  <graph id="PDND" edgedefault="directed">
    <data key="g_avvertenza">Le relazioni erogatore-fruitore non sono pubblicate come open data e sono ricostruite da documentazione pubblica: vedere il campo origine di ogni arco. I nodi marcati aggregato=true rappresentano insiemi di enti (per esempio circa 7.500 Comuni in un solo nodo): le misure di grado su questo grafo non sono confrontabili con quelle di un grafo non aggregato.</data>
    <data key="g_fonte">https://github.com/engineering87/pdnd-eservices-graph</data>
    <data key="g_doi">10.5281/zenodo.19989954</data>
